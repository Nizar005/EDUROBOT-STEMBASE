void loop() {



  if (digitalRead(pbka) == 0) {
    display.clearDisplay();
    menu++;
  } else if (digitalRead(pbki) == 0) {
    display.clearDisplay();
    menu--;
  }

  if (menu < 0) {
    menu = 3;
  } else if (menu > 3) {
    menu = 0;
  }

  if (menu == 0) {  //play

    display.display();

    display.drawBitmap(4, 5, bot, 50, 64, 1);

    display.fillRoundRect(63, 8, 62, 25, 10, 1);

    display.setTextColor(0);
